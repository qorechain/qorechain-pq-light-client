{
  "name": "@qorechain/pq-light-client",
  "version": "0.1.0",
  "description": "Reference verifier for QoreChain post-quantum light client checkpoints (ML-DSA-87, FIPS 204). Specification draft; requires chain support (not scheduled).",
  "license": "Apache-2.0",
  "author": "QoreChain Association",
  "homepage": "https://github.com/qorechain/qorechain-pq-light-client#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qorechain/qorechain-pq-light-client.git",
    "directory": "ts"
  },
  "bugs": {
    "url": "https://github.com/qorechain/qorechain-pq-light-client/issues"
  },
  "keywords": [
    "qorechain",
    "light-client",
    "ml-dsa",
    "fips-204",
    "post-quantum",
    "checkpoint"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@qorechain/pqc": "0.2.3"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "publishConfig": {
    "access": "public"
  },
  "pnpm": {
    "overrides": {
      "rollup": "4.64.5",
      "postcss": "8.5.30",
      "lilconfig": "3.1.3"
    }
  }
}
